/*<simulation_settings>
<ftestbench_cmd>quartus_eda --gen_testbench --tool=modelsim_oem --format=vhdl --write_settings_files=off projFinal -c projFinal --vector_source="C:/Projetos/Mestrado/LogicaReconf/FPGA/projFinal/output_files/Waveform.vwf" --testbench_file="C:/Projetos/Mestrado/LogicaReconf/FPGA/projFinal/simulation/qsim/output_files/Waveform.vwf.vht"</ftestbench_cmd>
<ttestbench_cmd>quartus_eda --gen_testbench --tool=modelsim_oem --format=vhdl --write_settings_files=off projFinal -c projFinal --vector_source="C:/Projetos/Mestrado/LogicaReconf/FPGA/projFinal/output_files/Waveform.vwf" --testbench_file="C:/Projetos/Mestrado/LogicaReconf/FPGA/projFinal/simulation/qsim/output_files/Waveform.vwf.vht"</ttestbench_cmd>
<fnetlist_cmd>quartus_eda --write_settings_files=off --simulation --functional=on --flatten_buses=off --tool=modelsim_oem --format=vhdl --output_directory="C:/Projetos/Mestrado/LogicaReconf/FPGA/projFinal/simulation/qsim/" projFinal -c projFinal</fnetlist_cmd>
<tnetlist_cmd>quartus_eda --write_settings_files=off --simulation --functional=off --flatten_buses=off --timescale=1ps --tool=modelsim_oem --format=vhdl --output_directory="C:/Projetos/Mestrado/LogicaReconf/FPGA/projFinal/simulation/qsim/" projFinal -c projFinal</tnetlist_cmd>
<modelsim_script>onerror {exit -code 1}
vlib work
vcom -work work projFinal.vho
vcom -work work output_files/Waveform.vwf.vht
vsim -novopt -c -t 1ps -L cyclone10lp -L altera -L altera_mf -L 220model -L sgate -L altera_lnsim work.sensor_controller_vhd_vec_tst
vcd file -direction projFinal.msim.vcd
vcd add -internal sensor_controller_vhd_vec_tst/*
vcd add -internal sensor_controller_vhd_vec_tst/i1/*
proc simTimestamp {} {
    echo "Simulation time: $::now ps"
    if { [string equal running [runStatus]] } {
        after 2500 simTimestamp
    }
}
after 2500 simTimestamp
run -all
quit -f

</modelsim_script>
<modelsim_script_timing>onerror {exit -code 1}
vlib work
vcom -work work projFinal.vho
vcom -work work output_files/Waveform.vwf.vht
vsim -novopt -c -t 1ps -sdfmax sensor_controller_vhd_vec_tst/i1=projFinal_vhd.sdo -L cyclone10lp -L altera -L altera_mf -L 220model -L sgate -L altera_lnsim work.sensor_controller_vhd_vec_tst
vcd file -direction projFinal.msim.vcd
vcd add -internal sensor_controller_vhd_vec_tst/*
vcd add -internal sensor_controller_vhd_vec_tst/i1/*
proc simTimestamp {} {
    echo "Simulation time: $::now ps"
    if { [string equal running [runStatus]] } {
        after 2500 simTimestamp
    }
}
after 2500 simTimestamp
run -all
quit -f

</modelsim_script_timing>
<hdl_lang>vhdl</hdl_lang>
</simulation_settings>*/
