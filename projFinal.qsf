# Portfolio-clean Quartus project file derived from the original academic project.
# Target: Cyclone 10 LP / Quartus Prime 18.1 Lite.

set_global_assignment -name FAMILY "Cyclone 10 LP"
set_global_assignment -name DEVICE 10CL025YU256I7G
set_global_assignment -name TOP_LEVEL_ENTITY sensor_controller
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 18.1.0
set_global_assignment -name LAST_QUARTUS_VERSION "18.1.0 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP "-40"
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 100
set_global_assignment -name NOMINAL_CORE_SUPPLY_VOLTAGE 1.2V

# Board pin assignments retained from the original project.
set_location_assignment PIN_E1  -to clk
set_location_assignment PIN_R1  -to rs232_rx
set_location_assignment PIN_P1  -to rs232_tx
set_location_assignment PIN_E15 -to btn_error
set_location_assignment PIN_F14 -to btn_manual1
set_location_assignment PIN_C11 -to btn_manual2
set_location_assignment PIN_D9  -to btn_manual3
set_location_assignment PIN_J15 -to reset
set_location_assignment PIN_L14 -to led1
set_location_assignment PIN_K15 -to led2
set_location_assignment PIN_J14 -to led3
set_location_assignment PIN_J13 -to led4

set_global_assignment -name VHDL_FILE rtl/uart_tx.vhd
set_global_assignment -name VHDL_FILE rtl/uart_rx.vhd
set_global_assignment -name VHDL_FILE rtl/error_buffer.vhd
set_global_assignment -name VHDL_FILE rtl/sensor_controller.vhd
